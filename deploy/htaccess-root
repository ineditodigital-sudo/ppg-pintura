# ---------------------------------------------------------------------------
# PPG COATINGS — SPA (React Router) + API PHP
# ---------------------------------------------------------------------------

Options -Indexes

# NO poner `DirectorySlash Off`. Se probó para evitar el 301 de `/colores` a
# `/colores/` y este servidor responde 403 a la página sin barra: peor el
# remedio. El salto se resuelve por el otro lado, haciendo que el canonical y
# el sitemap apunten ya a la forma con barra, que es la que el servidor sirve.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # El reto de Let's Encrypt se sirve tal cual, antes de cualquier otra regla.
  # Va la primera a propósito: si la renovación tuviera que pasar por la
  # redirección a HTTPS de abajo, el certificado dejaría de renovarse solo.
  RewriteRule ^\.well-known/ - [L]

  # Todo a HTTPS.
  # Sin esto, quien teclea el dominio sin escribir «https://» carga el sitio
  # en claro y el navegador lo marca como no seguro. Se comprueba `%{HTTPS}`
  # y también `X-Forwarded-Proto`, porque tras el proxy de LiteSpeed la
  # primera puede llegar apagada aunque la visita sí venga cifrada.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # /api/... → front controller. La URI original se conserva, que es de donde
  # el Router de PHP lee la ruta.
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ /api/index.php [L]

  # Servir la copia ya comprimida cuando el navegador la acepta.
  #
  # NO FUNCIONA EN ESTE HOSTING, y queda escrita a propósito. Se probaron las
  # dos formulaciones —con y sin barra inicial en la sustitución— y ninguna
  # dispara: delante hay un nginx que entrega los archivos de `/assets/` sin
  # pasar por estas reglas. Los `.gz` sí están subidos y se sirven
  # correctamente si se piden por su propia URL, con su tipo y su
  # `Content-Encoding` (ver los `FilesMatch` de más abajo), así que en cuanto
  # se encienda la compresión en cPanel —Optimizar sitio web— o se ponga el
  # proxy de Cloudflare delante del subdominio, esto empieza a servir solo.
  #
  # No se apunta el `index.html` directamente a los `.gz`: sería declarar
  # `Content-Encoding: gzip` a todo el mundo, incluido quien no lo pidió.
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}\.gz -f
  RewriteRule ^(.*)$ $1.gz [QSA,L]

  # Cualquier otra ruta que no sea un archivo o directorio real la resuelve
  # el enrutador del cliente. Permite recargar /color o /productos/aerospace.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# --- Caché ------------------------------------------------------------------
# Los bundles llevan hash en el nombre, así que son inmutables.
# index.html nunca se cachea: es quien apunta al bundle vigente.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # El video del hero salia sin TTL en PageSpeed: se volvia a descargar en
  # cada visita. Es inmutable -su nombre no cambia, pero tampoco su contenido-.
  <FilesMatch "\.(mp4|webm|m4v)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # `immutable` un año sólo vale si el nombre cambia con el contenido. Al
  # sustituir el vídeo del hero conservando `hero.mp4`, los navegadores que ya
  # lo tenían siguieron sirviendo el viejo. Por eso el archivo lleva la fecha
  # en el nombre: `hero-2026-08.mp4`. Al cambiarlo, renómbralo.

  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Cabeceras de seguridad ---
  # HSTS: el navegador recuerda que este dominio es sólo HTTPS y ni siquiera
  # llega a hacer la primera petición en claro. Seis meses, sin `preload` ni
  # `includeSubDomains`: afecta sólo a este host y se puede dar marcha atrás
  # bajando el `max-age` sin afectar a ningún otro host.
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # La política de contenido NO va aquí, va en un `<meta>` dentro de
  # `index.html` que genera el propio build. El motivo: `index.html` lleva dos
  # scripts en línea que tienen que ejecutarse mientras se analiza el HTML
  # —uno adelanta las peticiones de contenido y otro quita el velo de entrada—,
  # así que la política necesita su huella SHA-256. Escrita a mano aquí, se
  # desincronizaría en cuanto alguien tocara ese HTML y el sitio dejaría de
  # arrancar. Generada por el build, no puede desincronizarse.
  #
  # `frame-ancestors` no funciona en `<meta>`, pero para eso ya está el
  # `X-Frame-Options` de aquí arriba.
</IfModule>

# --- Compresión -------------------------------------------------------------
# Este hosting no comprime al vuelo. El envoltorio `<IfModule>` es obligatorio
# —sin él el servidor devuelve 500 en cada petición porque no reconoce la
# directiva— y con él la condición da falsa y no comprime nada. Encenderlo de
# verdad es entrar a cPanel (Optimizar sitio web), que no se puede hacer desde
# un despliegue por FTP.
#
# La salida es comprimir al compilar: junto a cada bundle queda su `.gz`, la
# regla de arriba lo sirve a quien lo acepte y aquí se le pone la cabecera y
# el tipo correctos. Sale mejor que comprimir en caliente —nivel 9, sin coste
# por petición— y no depende de ningún módulo del servidor.
#
# Medido antes: 359 KB de JS y 75 de CSS en crudo. Después: 168 KB en total.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # El `.gz` se entrega bajo la URL del archivo original, así que hay que
  # decirle al navegador que viene comprimido y de qué tipo es: si no, intenta
  # interpretar el gzip como JavaScript y la página no arranca.
  <FilesMatch "\.js\.gz$">
    ForceType application/javascript
    Header set Content-Encoding gzip
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.css\.gz$">
    ForceType text/css
    Header set Content-Encoding gzip
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.svg\.gz$">
    ForceType image/svg+xml
    Header set Content-Encoding gzip
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(json|xml|txt|webmanifest)\.gz$">
    Header set Content-Encoding gzip
  </FilesMatch>

  # Sin esto, una caché intermedia podría guardar la versión comprimida y
  # servírsela a un cliente que no la acepta.
  <FilesMatch "\.gz$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# --- Tipos MIME -------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# --- Archivos que nunca deben servirse --------------------------------------
<FilesMatch "(^\.|\.(jsonl|md|log)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
