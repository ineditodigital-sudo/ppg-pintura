# Directorio de subidas: sólo se sirven imágenes, nunca se ejecuta código.
# Es la segunda línea de defensa por si algo lograra colarse pese a la
# validación por finfo/getimagesize del MediaController.

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule lsapi_module>
  php_flag engine off
</IfModule>

# Neutraliza cualquier handler que pudiera ejecutar scripts aquí.
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .shtml
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phps

<FilesMatch "\.(php|php[0-9]|phtml|phps|pl|py|cgi|sh|shtml|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Sólo imágenes.
<FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>
