{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predev": "npm run sync:content",
        "dev": "vite",
        "sync:content": "node scripts/sync-content.mjs",
        "build": "npm run sync:content && npm run sitemap && tsc -b && vite build && npm run csp && npm run prerender && npm run llms && npm run comprimir",
        "csp": "node ../scripts/csp.mjs",
        "prerender": "node ../scripts/prerender.mjs",
        "llms": "node ../scripts/llms.mjs",
        "comprimir": "node scripts/comprimir.mjs",
        "lint": "oxlint",
        "preview": "vite preview",
        "sitemap": "node scripts/generar-sitemap.mjs"
    },
    "dependencies": {
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.1"
    },
    "devDependencies": {
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "oxlint": "^1.71.0",
        "sharp": "^0.35.3",
        "typescript": "~6.0.2",
        "vite": "^8.1.1"
    }
}
